{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "buildCommand": "npm run build -- --noEmit"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "daemons": {
    "reminders": {
      "root": "backend",
      "entrypoint": "Dockerfile.reminders",
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "1Gi" } }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
